# Copy this file to .env and change the passwords.
# .env is ignored by Git so real passwords never reach GitHub.

# Warehouse database
POSTGRES_USER=gifthub
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=gifthub_dw

# Used by Python scripts running on your own machine
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Airflow web login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123

# Linux users only: set this to the output of `id -u`
AIRFLOW_UID=50000
